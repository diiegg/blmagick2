# Google Search Console - verification meta tag
# Get from: https://search.google.com/search-console → Add property → URL prefix → HTML tag method
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Tag Manager / Google Ads - tracking ID (e.g., G-XXXXXXXXXX or AW-XXXXXXXXXX)
# Get from: https://tagmanager.google.com or https://ads.google.com → Tools → Conversions
NEXT_PUBLIC_GTM_ID=

# Google Ads conversion tracking - conversion label (e.g., AW-XXXXXXXXXX/XXXXXXXXXXXXX)
# Get from: https://ads.google.com → Goals → Conversions → Create conversion action
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=
